<Window x:Class="GeometryHandbook.App.Views.Dialogs.FigureEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource WindowStyle}">

    <DockPanel>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Скасувати"
                        IsCancel="True"
                        MinWidth="100"
                        Margin="0,0,8,0"/>
                <Button Content="{Binding ConfirmText}"
                        IsDefault="True"
                        MinWidth="100"
                        Style="{StaticResource BlueButtonStyle}"
                        Click="AddButton_Click"/>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Тип" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding TypeNames}"
                          SelectedItem="{Binding SelectedTypeName}"
                          IsEnabled="{Binding CanChangeType}"
                          Margin="0,0,0,12"/>

                <TextBlock Text="Підтип" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding Subtypes}"
                          SelectedItem="{Binding SelectedSubtype}"
                          DisplayMemberPath="SubtypeName"
                          IsEnabled="{Binding CanChangeType}"
                          Margin="0,0,0,12"/>

                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Підказка" Style="{StaticResource HeaderStyle}"/>
                    <TextBlock Text="Розміри вводяться в сантиметрах, кути — у градусах."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Дробові числа можна писати через кому або крапку."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Enter — підтвердити, Esc — скасувати."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>