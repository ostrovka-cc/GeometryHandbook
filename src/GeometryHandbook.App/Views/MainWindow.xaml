<Window x:Class="GeometryHandbook.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GeometryHandbook.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Довідник з геометрії"
        Height="650"
        Width="1150"
        Style="{StaticResource WindowStyle}">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Відкрити..."/>
                <MenuItem Header="_Зберегти..."/>
                <Separator/>
                <MenuItem Header="Ви_хід"/>
            </MenuItem>
            <MenuItem Header="Ф_ігура">
                <MenuItem Header="_Додати" Command="{Binding AddFigureCommand}"/>
                <MenuItem Header="Ви_далити"/>
                <Separator/>
                <MenuItem Header="_Сортувати за площею"/>
                <MenuItem Header="_Фільтр за периметром ±10%"/>
            </MenuItem>
            <MenuItem Header="_Довідка">
                <MenuItem Header="_Про програму"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="Додати" ToolTip="Додати нову фігуру" Command="{Binding AddFigureCommand}"/>
            <Button Content="Видалити" ToolTip="Видалити вибрану фігуру"/>
            <Separator/>
            <Button Content="Сортувати" ToolTip="Сортувати фігури за площею"/>
            <Button Content="Фільтр ±10%" ToolTip="Фігури з периметром у межах ±10% від середнього"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusMessage}"/>
            <Separator/>
            <StatusBarItem Content="Сітка: 1 клітинка = 1 см"/>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ZoomText" Text="Масштаб: 100%"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Фігури" Style="{StaticResource HeaderStyle}"/>
                    <ListBox ItemsSource="{Binding Figures}"
                             SelectedItem="{Binding SelectedFigure}"
                             DisplayMemberPath="Title"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="4">
                <ScrollViewer x:Name="FigureScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="FigureScroll_PreviewMouseWheel">
                    <Grid Width="20040" Height="20040" Background="White"
                          HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="SheetScale" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>

                        <Rectangle x:Name="MinorGrid">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile"
                                              Viewport="0,0,20,20" ViewportUnits="Absolute"
                                              Viewbox="0,0,20,20" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Geometry="M0,0 L20,0 M0,0 L0,20">
                                            <GeometryDrawing.Pen>
                                                <Pen x:Name="MinorGridPen" Brush="#E0E0E0" Thickness="2"/>
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Rectangle>
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile"
                                              Viewport="0,0,200,200" ViewportUnits="Absolute"
                                              Viewbox="0,0,200,200" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Geometry="M0,0 L200,0 M0,0 L0,200">
                                            <GeometryDrawing.Pen>
                                                <Pen x:Name="MajorGridPen" Brush="#A0A0A0" Thickness="4"/>
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Path x:Name="FigurePath"
                              Data="{Binding SelectedFigure.Geometry}"
                              Fill="{Binding SelectedFigure.Model.FillColor}"
                              Stroke="{StaticResource TextBrush}"
                              StrokeThickness="2"
                              Margin="20"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Нова фігура" Style="{StaticResource HeaderStyle}"/>

                        <TextBlock Text="Тип" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Editor.TypeNames}"
                                  SelectedItem="{Binding Editor.SelectedTypeName}"/>

                        <TextBlock Text="Підтип" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Editor.Subtypes}"
                                  SelectedItem="{Binding Editor.SelectedSubtype}"
                                  DisplayMemberPath="SubtypeName"/>

                        <ItemsControl ItemsSource="{Binding Editor.Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Додати фігуру"
                                Style="{StaticResource MainButtonStyle}"
                                Command="{Binding AddFigureCommand}"
                                ToolTip="Створити фігуру з введеними параметрами"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Характеристики" Style="{StaticResource HeaderStyle}"/>
                        <DataGrid ItemsSource="{Binding SelectedFigure.Properties}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Значення" Binding="{Binding Value, StringFormat={}{0:0.##}}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

    </DockPanel>
</Window>