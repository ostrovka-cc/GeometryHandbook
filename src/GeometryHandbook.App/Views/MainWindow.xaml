<Window x:Class="GeometryHandbook.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeometryHandbook.App" xmlns:viewmodels="clr-namespace:GeometryHandbook.App.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="Довідник із геометрії" MinHeight="200" MinWidth="500" Height ="700" Width ="1100">

    <Window.Resources>
        <DrawingBrush x:Key="GridBrush"
                      TileMode="Tile"
                      Viewport="0,0,20,20" ViewportUnits="Absolute"
                      Viewbox="0,0,20,20" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,0 L20,0 M0,0 L0,20">
                    <GeometryDrawing.Pen>
                        <Pen Brush="LightGray" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <DockPanel >
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Відкрити"></MenuItem>
                <Separator/>
                <MenuItem Header="Вихід"></MenuItem>
            </MenuItem>

            <MenuItem Header="Фігура">
                <MenuItem Header="Вибрати фігуру"></MenuItem>
                <Separator/>
                <MenuItem Header="Змінити фігуру"></MenuItem>
                <Separator/>
                <MenuItem Header="Скинути фігуру"></MenuItem>
            </MenuItem>

            <MenuItem Header="Дії">
                <MenuItem Header="Повернутися назад"></MenuItem>
                <Separator/>
                <MenuItem Header="Вихід"></MenuItem>
            </MenuItem>

            <MenuItem Header="Довідка" Background="AntiqueWhite">
                <MenuItem Header="Відкрити"></MenuItem>
                <Separator/>
                <MenuItem Header="Вихід"></MenuItem>
            </MenuItem>
        </Menu>
        <ToolBar   DockPanel.Dock="Top"   Background="SkyBlue">

            <ToolBar.Resources>

                <Style TargetType="Button">
                    <Setter Property="Background" Value="LightBlue"/>
                    <Setter Property="Margin" Value="4,0"/>
                </Style>
            </ToolBar.Resources>

            <Button Content="+" ToolTip="Додати фігуру" Command="{Binding AddFigureCommand}"/>
            <Button Content="−" ToolTip="Видалити обрану фігуру"/>
            <Button Content="Сортувати" ToolTip="Відсортувати фігури за площею"/>
            <Button Content="Фільтр ±10%" ToolTip="Показати фігури з периметром ±10% від середнього"/>

        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom" Background="AliceBlue">
            <TextBlock Text="Сітка: 1 клітинка = 1 см" Margin="0,0,10,0"/>
            <TextBlock x:Name="ZoomText" Text="Масштаб: 100%"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Список фігур" Margin="4">
                <ListBox 
                    ItemsSource ="{Binding Figures}"
                    SelectedItem ="{Binding SelectedFigure}"
                    DisplayMemberPath="Title"
                    />
            </GroupBox>

            <Border Grid.Column="1" Margin="4"
        Background="White" BorderBrush="Gray" BorderThickness="1">
                <ScrollViewer x:Name="FigureScroll"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="FigureScroll_PreviewMouseWheel">
                    <Grid Width="20040" Height="20040">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="SheetScale" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>

                        <Rectangle x:Name="MinorGrid">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile"
                                  Viewport="0,0,20,20" ViewportUnits="Absolute"
                                  Viewbox="0,0,20,20" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Geometry="M0,0 L20,0 M0,0 L0,20">
                                            <GeometryDrawing.Pen>
                                                <Pen x:Name="MinorGridPen" Brush="#E0E0E0" Thickness="2"/>
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Rectangle>
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile"
                                  Viewport="0,0,200,200" ViewportUnits="Absolute"
                                  Viewbox="0,0,200,200" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Geometry="M0,0 L200,0 M0,0 L0,200">
                                            <GeometryDrawing.Pen>
                                                <Pen x:Name="MajorGridPen" Brush="#A0A0A0" Thickness="4"/>
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Path x:Name="FigurePath"
                  Data="{Binding SelectedFigure.Geometry}"
                  Fill="{Binding SelectedFigure.Model.FillColor}"
                  Stroke="Black"
                  StrokeThickness="2"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="20"/>
                    </Grid>
                </ScrollViewer>
            </Border>
            
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Нова фігура" Margin="4">
                    <StackPanel Margin="4">
                        <TextBlock Text="Тип:"/>
                        <ComboBox Margin="0,2,0,6"
                                  ItemsSource ="{Binding Editor.TypeNames}"
                                  SelectedItem="{Binding Editor.SelectedTypeName}"/>
                        <TextBlock Text="Підтип:"/>
                        <ComboBox Margin="0,2,0,6"
                                  ItemsSource ="{Binding Editor.Subtypes}"
                                  SelectedItem="{Binding Editor.SelectedSubtype}"
                                  DisplayMemberPath="SubtypeName"/>

                        <ItemsControl ItemsSource="{Binding Editor.Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2,0,4">
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Додати" Margin="0,8,0,0" Command="{Binding AddFigureCommand}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Характеристики" Margin="4">
                    <DataGrid ItemsSource="{Binding SelectedFigure.Properties}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Характеристика"
                                                Binding="{Binding Name}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Значення"
                                                Binding="{Binding Value, StringFormat={}{0:0.##}}"
                                                Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>

    </DockPanel>
</Window>