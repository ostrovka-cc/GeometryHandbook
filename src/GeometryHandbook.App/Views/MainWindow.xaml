<Window x:Class="GeometryHandbook.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeometryHandbook.App" xmlns:viewmodels="clr-namespace:GeometryHandbook.App.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="Довідник із геометрії" MinHeight="200" MinWidth="500" Height ="700" Width ="1100">
   
    <DockPanel >
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Відкрити"></MenuItem>
                <Separator/>
                <MenuItem Header="Вихід"></MenuItem>
            </MenuItem>

            <MenuItem Header="Фігура">
                <MenuItem Header="Вибрати фігуру"></MenuItem>
                <Separator/>
                <MenuItem Header="Змінити фігуру"></MenuItem>
                <Separator/>
                <MenuItem Header="Скинути фігуру"></MenuItem>
            </MenuItem>

            <MenuItem Header="Дії">
                <MenuItem Header="Повернутися назад"></MenuItem>
                <Separator/>
                <MenuItem Header="Вихід"></MenuItem>
            </MenuItem>

            <MenuItem Header="Довідка" Background="AntiqueWhite">
                <MenuItem Header="Відкрити"></MenuItem>
                <Separator/>
                <MenuItem Header="Вихід"></MenuItem>
            </MenuItem>
        </Menu>
        <ToolBar   DockPanel.Dock="Top"   Background="SkyBlue">

            <ToolBar.Resources>
              
                <Style TargetType="Button">
                    <Setter Property="Background" Value="LightBlue"/>
                    <Setter Property="Margin" Value="4,0"/>
                </Style>
            </ToolBar.Resources>
            
            <Button Content="+" ToolTip="Додати фігуру" Command="{Binding AddCircleCommand}"/>
            <Button Content="−" ToolTip="Видалити обрану фігуру"/>
            <Button Content="Сортувати" ToolTip="Відсортувати фігури за площею"/>
            <Button Content="Фільтр ±10%" ToolTip="Показати фігури з периметром ±10% від середнього"/>

        </ToolBar>
        <StatusBar DockPanel.Dock="Bottom" Background="AliceBlue">
            <TextBlock Margin="5, 0, 10, 0" Text="Колір = "></TextBlock>
            <TextBlock Text="Масштаб = "></TextBlock>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Список фігур" Margin="4">
                <ListBox 
                    ItemsSource ="{Binding Figures}"
                    SelectedItem ="{Binding SelectedFigure}"
                    DisplayMemberPath="Title"
                    />
                    
               
            </GroupBox>


            <Border Grid.Column="1" Margin="4"
        Background="White" BorderBrush="Gray" BorderThickness="1">
                <TextBlock Text="МЯВ"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="Gray"/>
            </Border>


            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <GroupBox Grid.Row="0" Header="Нова фігура" Margin="4">
                    <StackPanel Margin="4">
                        <TextBlock Text="Тип:"/>
                        <ComboBox Margin="0,2,0,6"/>
                        <TextBlock Text="Підтип:"/>
                        <ComboBox Margin="0,2,0,6"/>
                        <TextBlock Text="(мяв)" Foreground="Gray"/>
                        <Button Content="Додати" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>


                <GroupBox Grid.Row="1" Header="Характеристики" Margin="4">
                    <DataGrid/>
                </GroupBox>
            </Grid>
        </Grid>

       

    </DockPanel>
</Window>
