<Window x:Class="GeometryHandbook.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GeometryHandbook.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Довідник з геометрії"
        Height="650"
        Width="1150"
        Style="{StaticResource WindowStyle}">

    <DockPanel>

        <Menu DockPanel.Dock="Top" Background="{StaticResource BackgroundBrush}">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Відкрити..."/>
                <MenuItem Header="_Зберегти..."/>
                <Separator/>
                <MenuItem Header="Ви_хід"/>
            </MenuItem>
            <MenuItem Header="Ф_ігура">
                <MenuItem Header="_Нова фігура..." Command="{Binding AddFigureCommand}"/>
                <MenuItem Header="_Редагувати..." Command="{Binding EditFigureCommand}"/>
                <MenuItem Header="Ви_далити" Command="{Binding DeleteFigureCommand}"/>
            </MenuItem>
            <MenuItem Header="_Дії">
                <MenuItem Header="_Сортувати за площею" Command="{Binding SortFiguresCommand}"/>
                <MenuItem Header="_Фільтр за периметром ±10%..." Command="{Binding FilterByPerimeterCommand}"/>
                <Separator/>
                <MenuItem Header="_Зафарбувати" Command="{Binding FillFigureCommand}"/>
                <MenuItem Header="_Масштабувати" Command="{Binding ScaleFigureCommand}"/>
            </MenuItem>
            <MenuItem Header="_Довідка">
                <MenuItem Header="_Про програму"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Background="{StaticResource BackgroundBrush}" Padding="6,4">
            <Button Content="Відкрити" ToolTip="Відкрити фігури з файлу"/>
            <Button Content="Зберегти" ToolTip="Зберегти фігури у файл"/>
            <Separator/>
            <Button Content="+ Нова фігура"
                    Style="{StaticResource BlueButtonStyle}"
                    Command="{Binding AddFigureCommand}"
                    ToolTip="Додати нову фігуру"
                    Margin="4,0"/>
            <Button Content="Редагувати" Command="{Binding EditFigureCommand}" ToolTip="Змінити розміри вибраної фігури"/>
            <Button Content="Видалити" Command="{Binding DeleteFigureCommand}" ToolTip="Видалити вибрану фігуру"/>
            <Separator/>
            <Button Content="Сортувати" Command="{Binding SortFiguresCommand}" ToolTip="Сортувати фігури за площею за зростанням (метод підрахунку)"/>
            <Button Content="Фільтр ±10%" Command="{Binding FilterByPerimeterCommand}" ToolTip="Фігури з периметром у межах ±10% від середнього"/>
            <Separator/>
            <ComboBox ItemsSource="{Binding FillColors}"
                      SelectedItem="{Binding SelectedColor}"
                      Style="{StaticResource {x:Type ComboBox}}"
                      Width="170"
                      MaxDropDownHeight="320"
                      ToolTip="Колір для заливки">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{Binding}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Зафарбувати" Command="{Binding FillFigureCommand}" ToolTip="Зафарбувати вибрану фігуру вибраним кольором"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom"
                   Background="{StaticResource BackgroundBrush}"
                   Foreground="{StaticResource SecondaryTextBrush}">
            <StatusBarItem Content="{Binding StatusMessage}"/>
            <Separator/>
            <StatusBarItem Content="1 клітинка = 1 см"/>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ZoomText" Text="Масштаб: 100%"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Список фігур" Style="{StaticResource HeaderStyle}"/>
                    <ListBox ItemsSource="{Binding Figures}"
                             SelectedItem="{Binding SelectedFigure}"
                             Background="Transparent"
                             BorderThickness="0">

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Нова фігура..." Command="{Binding AddFigureCommand}"/>
                                <MenuItem Header="Редагувати..." Command="{Binding EditFigureCommand}"/>
                                <MenuItem Header="Видалити" Command="{Binding DeleteFigureCommand}"/>
                                <Separator/>
                                <MenuItem Header="Зафарбувати" Command="{Binding FillFigureCommand}"/>
                                <MenuItem Header="Масштабувати" Command="{Binding ScaleFigureCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteFigureCommand}"/>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditFigureCommand}"/>
                        </ListBox.InputBindings>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Model.DisplayName}"/>
                                    <TextBlock Text="{Binding Area, StringFormat='S = {0:0.##} см²'}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="4">
                <DockPanel>

                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="8,8,8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Масштаб ×"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,8,0"/>
                            <TextBox Text="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="90"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Масштаб відносно початкового розміру; введіть число й натисніть Enter">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ScaleFigureCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Застосувати"
                                    Command="{Binding ScaleFigureCommand}"
                                    ToolTip="Встановити вибраній фігурі цей масштаб"
                                    Margin="8,0,0,0"/>
                            <TextBlock Text="1 — початковий розмір"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="16,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="FigureScroll"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="FigureScroll_PreviewMouseWheel">
                        <Grid Width="20040"
                              Height="20040"
                              Background="{StaticResource CanvasBrush}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="SheetScale" ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>

                            <Rectangle x:Name="MinorGrid">
                                <Rectangle.Fill>
                                    <DrawingBrush TileMode="Tile"
                                                  Viewport="0,0,20,20" ViewportUnits="Absolute"
                                                  Viewbox="0,0,20,20" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Geometry="M0,0 L20,0 M0,0 L0,20">
                                                <GeometryDrawing.Pen>
                                                    <Pen x:Name="MinorGridPen" Brush="#2A2A2A" Thickness="2"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Rectangle>
                                <Rectangle.Fill>
                                    <DrawingBrush TileMode="Tile"
                                                  Viewport="0,0,200,200" ViewportUnits="Absolute"
                                                  Viewbox="0,0,200,200" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Geometry="M0,0 L200,0 M0,0 L0,200">
                                                <GeometryDrawing.Pen>
                                                    <Pen x:Name="MajorGridPen" Brush="#3E3E3E" Thickness="4"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Path x:Name="FigurePath"
                                  Data="{Binding SelectedFigure.Geometry}"
                                  Fill="{Binding SelectedFigure.FillColor}"
                                  Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="2"
                                  Margin="20"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"/>
                        </Grid>
                    </ScrollViewer>

                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="10">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="Характеристики">
                        <DataGrid ItemsSource="{Binding SelectedFigure.Properties}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource LineBrush}"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  BorderThickness="0"
                                  Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Значення" Binding="{Binding Value, StringFormat={}{0:0.##}}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Формули">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding SelectedFigure.Formulas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,8">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

    </DockPanel>
</Window>